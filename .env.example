# LLM
# OpenAI-compatible example:
# PAPERAGENT_LLM_PROTOCOL=openai
# PAPERAGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# PAPERAGENT_LLM_MODEL=glm-4.5-flash
#
# Anthropic-compatible example:
# PAPERAGENT_LLM_PROTOCOL=anthropic
# PAPERAGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# PAPERAGENT_LLM_MODEL=glm-5.3
PAPERAGENT_LLM_PROTOCOL=openai
PAPERAGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PAPERAGENT_LLM_API_KEY=your_api_key_here
PAPERAGENT_LLM_MODEL=glm-4.5-flash

# 文献检索（Semantic Scholar 免 key 可用，有速率限制；可选填 key 提高配额）
S2_API_KEY=

# workspace 根目录（默认 ./workspace）
PAPERAGENT_WORKSPACE=./workspace

# Prefer the OS credential store: paperagent secrets set LLM_API_KEY
# Optional independent fast credentials: paperagent secrets set FAST_LLM_API_KEY
# .env keys remain a fallback; product.json never contains credentials.
# PAPERAGENT_PRODUCT_CONFIG=/absolute/path/product.json
# PAPERAGENT_FAST_LLM_BASE_URL=https://your-fast-provider/v1
# PAPERAGENT_FAST_LLM_MODEL=your-fast-model
# PAPERAGENT_FAST_LLM_PROTOCOL=openai

# Optional lifecycle cloud sync (default off; bind and confirm separately per project).
# PAPERAGENT_CLOUD_URL=https://your-cloud-origin
# PAPERAGENT_CLOUD_TOKEN=your-login-token
# PAPERAGENT_CLOUD_DEVICE_TOKEN=your-registered-device-token
# Keep tokens in process environment; never put them in project meta.json.
